FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client ca-certificates \
    && apt-get clean
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
ENV DATA_DIR=/data CLOUD_EXPORT_DIR=/export/codex PORT=3461
VOLUME ["/data", "/export"]
EXPOSE 3461
CMD ["node", "dist/cloud-server.js"]
